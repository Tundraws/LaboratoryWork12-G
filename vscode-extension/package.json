{
  "name": "clinic-code-explainer",
  "displayName": "Clinic Code Explainer",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:clinic.explainCode"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clinic.explainCode",
        "title": "Explain Selected Code"
      }
    ],
    "keybindings": [
      {
        "command": "clinic.explainCode",
        "key": "ctrl+shift+e",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Clinic Code Explainer",
      "properties": {
        "clinicCodeExplainer.apiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key"
        },
        "clinicCodeExplainer.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "DeepSeek model name"
        },
        "clinicCodeExplainer.endpoint": {
          "type": "string",
          "default": "https://api.deepseek.com/chat/completions",
          "description": "DeepSeek OpenAI-compatible chat completions endpoint"
        }
      }
    }
  }
}
